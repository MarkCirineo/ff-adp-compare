# ==================================
# ADP Scout — Production Environment
# ==================================
# Copy this file to .env.production and fill in real values.
# This file is used by docker-compose.yml.
#
# NEVER commit .env.production — it contains secrets.

# ---- PostgreSQL ----
# These are used by the postgres container to create the DB on first run.
POSTGRES_USER=adpscout
POSTGRES_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD
POSTGRES_DB=adpscout

# ---- App ----
# DATABASE_URL must match the postgres credentials above.
# Host is "db" (the docker-compose service name).
DATABASE_URL="postgresql://adpscout:CHANGE_ME_TO_A_STRONG_PASSWORD@db:5432/adpscout?schema=public"

NEXT_PUBLIC_APP_NAME="ADP Scout"
NEXT_PUBLIC_BASE_URL="https://adpscout.com"
NODE_ENV="production"
