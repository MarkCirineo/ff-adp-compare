generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// players — canonical player identity
// ============================================
model Player {
  id             String       @id @default(cuid())
  name           String
  normalizedName String       @map("normalized_name")
  team           String?
  position       String
  byeWeek        Int?         @map("bye_week")
  imageUrl       String?      @map("image_url")
  sleeperId      String?      @unique @map("sleeper_id")
  espnId         String?      @unique @map("espn_id")
  yahooId        String?      @unique @map("yahoo_id")
  fantasyProsId  String?      @unique @map("fantasy_pros_id")
  externalIds    Json?        @map("external_ids")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  rankings    Ranking[]
  adpEntries  Adp[]
  projections Projection[]

  @@index([normalizedName])
  @@index([position])
  @@index([team])
  @@map("players")
}

// ============================================
// rankings — per-source expert/staff rankings
// ============================================
model Ranking {
  id        String   @id @default(cuid())
  playerId  String   @map("player_id")
  source    String
  rank      Int
  posRank   String?  @map("pos_rank")
  format    String   @default("redraft")
  scoring   String   @default("half_ppr")
  season    Int
  updatedAt DateTime @updatedAt @map("updated_at")

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([playerId, source, format, scoring, season])
  @@index([source])
  @@index([format, scoring])
  @@map("rankings")
}

// ============================================
// adp — per-source average draft position
// ============================================
model Adp {
  id        String   @id @default(cuid())
  playerId  String   @map("player_id")
  source    String
  adp       Float
  format    String   @default("redraft")
  scoring   String   @default("half_ppr")
  season    Int
  updatedAt DateTime @updatedAt @map("updated_at")

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([playerId, source, format, scoring, season])
  @@index([source])
  @@index([format, scoring])
  @@map("adp")
}

// ============================================
// projections — season stat projections
// ============================================
model Projection {
  id         String   @id @default(cuid())
  playerId   String   @map("player_id")
  source     String
  season     Int
  ptsStd     Float?   @map("pts_std")
  ptsHalfPpr Float?   @map("pts_half_ppr")
  ptsPpr     Float?   @map("pts_ppr")
  passYd     Float?   @map("pass_yd")
  passTd     Float?   @map("pass_td")
  rushYd     Float?   @map("rush_yd")
  rushTd     Float?   @map("rush_td")
  rec        Float?
  recYd      Float?   @map("rec_yd")
  recTd      Float?   @map("rec_td")
  updatedAt  DateTime @updatedAt @map("updated_at")

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([playerId, source, season])
  @@map("projections")
}

// ============================================
// saved_leagues — user league configurations
// ============================================
model SavedLeague {
  id            String   @id @default(cuid())
  name          String
  leagueSize    Int      @default(12) @map("league_size")
  draftPosition Int      @default(1) @map("draft_position")
  scoring       String   @default("half_ppr")
  format        String   @default("redraft")
  roster        String   @default("1qb")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("saved_leagues")
}

// ============================================
// sync_log — data pipeline audit trail
// ============================================
model SyncLog {
  id           String    @id @default(cuid())
  source       String
  status       String
  playersFound Int       @default(0) @map("players_found")
  errors       Json?
  startedAt    DateTime  @map("started_at")
  completedAt  DateTime? @map("completed_at")

  @@map("sync_log")
}
